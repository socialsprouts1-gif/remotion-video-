# ---------- Core ----------
DATABASE_URL="postgresql://studio:studio@localhost:5432/studio"
REDIS_URL="redis://127.0.0.1:6379"
# Public base URL of the app. Render workers fetch media from here via signed URLs.
APP_URL="http://localhost:3000"
# 32+ random bytes (hex). Signs sessions-independent media URLs. `openssl rand -hex 32`
APP_SECRET=""

# ---------- Storage ----------
# "local" (files under STORAGE_DIR) or "s3" (any S3-compatible store; see docs/ENVIRONMENT.md)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# S3_ENDPOINT=""  S3_REGION=""  S3_BUCKET=""  S3_ACCESS_KEY_ID=""  S3_SECRET_ACCESS_KEY=""

# ---------- Rendering ----------
# Path to a Chrome / headless-shell binary for Remotion. Leave empty to let Remotion download its own.
REMOTION_BROWSER_EXECUTABLE=""
RENDER_CONCURRENCY="2"

# ---------- Auth ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated emails that become ADMIN on signup
ADMIN_EMAILS=""

# ---------- AI providers (all optional; features show "integration required" when missing) ----------
ANTHROPIC_API_KEY=""        # AI Director, editing assistant, script-to-video (Claude)
FAL_KEY=""                  # fal.ai: text/image-to-video, text-to-image, background removal, upscaling
REPLICATE_API_TOKEN=""      # Replicate: alternative model host
RUNWAYML_API_SECRET=""      # Runway: image-to-video
LUMA_API_KEY=""             # Luma Dream Machine: text/image-to-video
ELEVENLABS_API_KEY=""       # ElevenLabs: TTS, voiceover, speech-to-text
# Enables the clearly-labelled development mock provider (never on in production)
ENABLE_MOCK_PROVIDER="false"

# ---------- Billing ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_CREATOR=""
STRIPE_PRICE_STUDIO=""
