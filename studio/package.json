{
  "name": "lumora-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Lumora Studio - AI video production platform (editor, motion graphics, AI director, render pipeline)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx worker/render-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@prisma/client": "6.19.3",
    "@remotion/bundler": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "bcryptjs": "3.0.2",
    "bullmq": "5.61.0",
    "clsx": "2.1.1",
    "framer-motion": "12.23.24",
    "ioredis": "5.8.2",
    "lucide-react": "0.548.0",
    "nanoid": "5.1.6",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.12",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.6.3"
  }
}
