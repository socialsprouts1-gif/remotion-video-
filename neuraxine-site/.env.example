# Copy to .env (or set in your host's dashboard). Every key is optional:
# without it, that demo runs in its built-in mode and the site still works.
# The audit form needs no keys: it opens WhatsApp (number in src/site.js).

# Claude powers the WhatsApp agent replies, lead scoring and outreach drafts.
ANTHROPIC_API_KEY=

# Real businesses in the lead-gen demo (Google Places API, New).
GOOGLE_PLACES_API_KEY=

# Workflow demo steps are POSTed here (n8n Webhook node URL).
N8N_WEBHOOK_URL=

PORT=8787
