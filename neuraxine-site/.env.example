# Copy to .env (or set in your host's dashboard). Every key is optional:
# without it, that feature runs in demo mode and the site still works.

# Claude powers the WhatsApp agent replies, lead scoring and outreach drafts.
ANTHROPIC_API_KEY=

# Real businesses in the lead-gen demo (Google Places API, New).
GOOGLE_PLACES_API_KEY=

# Audit requests and workflow steps are POSTed here (n8n Webhook node URL).
N8N_WEBHOOK_URL=

# Email a copy of each audit request (resend.com).
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=Neuraxine <onboarding@resend.dev>

# Where submissions are stored (JSON lines). Defaults to ./data
DATA_DIR=
PORT=8787
